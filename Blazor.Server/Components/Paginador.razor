<div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 my-3 pt-3 border-top">
    <div class="d-flex flex-wrap align-items-center gap-3 text-secondary small">
        <span class="text-nowrap">
            Mostrando <strong>@RangoInicio</strong> a <strong>@RangoFin</strong> de <strong>@TotalItems</strong>
        </span>

        @if (MostrarSelectorTamano)
        {
            <div class="d-flex align-items-center gap-2">
                <label for="paginador-size-select" class="text-nowrap mb-0">Filas por página:</label>
                <select id="paginador-size-select" 
                        class="form-select form-select-sm" 
                        style="width: 75px; min-width: 75px; padding-right: 1.75rem;" 
                        value="@PageSize" 
                        @onchange="OnPageSizeSelectChanged">
                    @foreach (var size in OpcionesTamano)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        }
    </div>

    @if (TotalPaginas > 1)
    {
        <nav aria-label="Paginación">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(PaginaActual <= 1 ? "disabled" : "")">
                    <button class="page-link px-2" type="button" @onclick="() => IrAPagina(1)" title="Primera página">
                        &laquo;
                    </button>
                </li>
                <li class="page-item @(PaginaActual <= 1 ? "disabled" : "")">
                    <button class="page-link px-2" type="button" @onclick="() => IrAPagina(PaginaActual - 1)" title="Página anterior">
                        &lsaquo;
                    </button>
                </li>

                @for (int i = PaginaInicio; i <= PaginaFin; i++)
                {
                    var p = i;
                    <li class="page-item @(p == PaginaActual ? "active" : "")">
                        <button class="page-link px-3" type="button" @onclick="() => IrAPagina(p)">@p</button>
                    </li>
                }

                <li class="page-item @(PaginaActual >= TotalPaginas ? "disabled" : "")">
                    <button class="page-link px-2" type="button" @onclick="() => IrAPagina(PaginaActual + 1)" title="Página siguiente">
                        &rsaquo;
                    </button>
                </li>
                <li class="page-item @(PaginaActual >= TotalPaginas ? "disabled" : "")">
                    <button class="page-link px-2" type="button" @onclick="() => IrAPagina(TotalPaginas)" title="Última página">
                        &raquo;
                    </button>
                </li>
            </ul>
        </nav>
    }
</div>

@code {
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int PaginaActual { get; set; } = 1;
    [Parameter] public EventCallback<int> PaginaActualChanged { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter] public bool MostrarSelectorTamano { get; set; } = true;
    [Parameter] public int[] OpcionesTamano { get; set; } = new[] { 5, 10, 20, 50 };

    public int TotalPaginas => Math.Max(1, (int)Math.Ceiling((double)TotalItems / (PageSize <= 0 ? 10 : PageSize)));

    private int RangoInicio => TotalItems == 0 ? 0 : ((PaginaActual - 1) * PageSize) + 1;
    private int RangoFin => Math.Min(PaginaActual * PageSize, TotalItems);

    private int PaginaInicio => Math.Max(1, PaginaActual - 2);
    private int PaginaFin => Math.Min(TotalPaginas, Math.Max(1, PaginaActual - 2) + 4);

    private async Task IrAPagina(int pagina)
    {
        if (pagina < 1) pagina = 1;
        if (pagina > TotalPaginas) pagina = TotalPaginas;
        if (pagina != PaginaActual)
        {
            PaginaActual = pagina;
            await PaginaActualChanged.InvokeAsync(PaginaActual);
        }
    }

    private async Task OnPageSizeSelectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoSize) && nuevoSize > 0)
        {
            PageSize = nuevoSize;
            await PageSizeChanged.InvokeAsync(PageSize);

            // Ajustar página si queda fuera de rango
            if (PaginaActual > TotalPaginas)
            {
                PaginaActual = TotalPaginas;
                await PaginaActualChanged.InvokeAsync(PaginaActual);
            }
        }
    }
}
