@inject IBlazorAuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="sidebar-header p-3 d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25">
    <div class="d-flex align-items-center gap-2">
        <img src="images/logo-icon.png" alt="DentalCare Logo" style="height: 38px; width: auto; object-fit: contain;" />
        <div class="d-flex flex-column">
            <span class="brand-title fw-bold text-white lh-1" style="font-size: 1.15rem; letter-spacing: -0.02em;">DentalCare</span>
            <span class="brand-subtitle text-secondary small" style="font-size: 0.72rem;">Consultorio Odontológico</span>
        </div>
    </div>
    <button class="btn btn-sm btn-link text-white-50 d-md-none p-1" @onclick="CerrarMenuEnMovil" title="Cerrar">
        <i class="bi bi-x-lg fs-5"></i>
    </button>
</div>

<div class="nav-container p-2 flex-grow-1 overflow-y-auto">
    <nav class="nav flex-column gap-1">
        <div class="nav-item">
            <NavLink class="nav-link custom-nav-link" href="" Match="NavLinkMatch.All" @onclick="CerrarMenuEnMovil">
                <i class="bi bi-grid-1x2-fill me-2"></i> Inicio
            </NavLink>
        </div>

        @if (rol == "Administrador")
        {
            <div class="nav-section-title px-3 pt-3 pb-1 text-uppercase text-secondary" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
                Administración
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="pacientes" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-people-fill me-2"></i> Pacientes
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="odontologos" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-person-badge-fill me-2"></i> Odontólogos
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="turnos" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-calendar-week me-2"></i> Turnos
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="atender" @onclick="CerrarMenuEnMovil"><i class="bi bi-heart-pulse-fill me-2"></i> Atender Reserva</NavLink></div><div class="nav-item"><NavLink class="nav-link custom-nav-link" href="reservas" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-journal-check me-2"></i> Reservas
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="reservar" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-plus-circle me-2"></i> Nueva Reserva
                </NavLink>
            </div>
        }
        else if (rol == "Odontologo")
        {
            <div class="nav-section-title px-3 pt-3 pb-1 text-uppercase text-secondary" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
                Panel Profesional
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="turnos" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-calendar-week me-2"></i> Mis turnos
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="atender" @onclick="CerrarMenuEnMovil"><i class="bi bi-heart-pulse-fill me-2"></i> Atender Reserva</NavLink></div><div class="nav-item"><NavLink class="nav-link custom-nav-link" href="reservas" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-journal-check me-2"></i> Mis reservas
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="reservar" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-plus-circle me-2"></i> Reservar turno
                </NavLink>
            </div>
        }
        else if (rol == "Paciente")
        {
            <div class="nav-section-title px-3 pt-3 pb-1 text-uppercase text-secondary" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
                Paciente
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="reservar" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-calendar-plus me-2"></i> Reservar turno
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link custom-nav-link" href="mis-reservas" @onclick="CerrarMenuEnMovil">
                    <i class="bi bi-clock-history me-2"></i> Mis reservas
                </NavLink>
            </div>
        }
    </nav>
</div>

<div class="user-footer mt-auto p-3 border-top border-secondary border-opacity-25">
    @if (nombre is null)
    {
        <NavLink class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center gap-2" href="login" @onclick="CerrarMenuEnMovil">
            <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
        </NavLink>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2 overflow-hidden">
                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; min-width: 36px; font-weight: 600;">
                    @(string.IsNullOrEmpty(nombre) ? "U" : nombre[0].ToString().ToUpper())
                </div>
                <div class="user-info overflow-hidden">
                    <div class="text-white text-truncate fw-semibold small">@nombre</div>
                    <span class="badge bg-secondary bg-opacity-50 text-light px-1" style="font-size: 0.65rem;">@rol</span>
                </div>
            </div>
            <button class="btn btn-sm btn-link text-secondary text-hover-light p-1" @onclick="LogoutAsync" title="Cerrar sesión">
                <i class="bi bi-box-arrow-right fs-5"></i>
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnToggleMenu { get; set; }

    private string? nombre;
    private string? rol;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthenticationStateChanged += OnAuthChanged;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        nombre = await AuthService.GetNombreAsync();
        rol = await AuthService.GetRolAsync();
    }

    private async void OnAuthChanged(bool autenticado)
    {
        await CargarAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CerrarMenuEnMovil()
    {
        if (OnToggleMenu.HasDelegate)
        {
            await OnToggleMenu.InvokeAsync();
        }
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        await CerrarMenuEnMovil();
        Navigation.NavigateTo("/login");
    }

    public void Dispose() => AuthService.AuthenticationStateChanged -= OnAuthChanged;
}
