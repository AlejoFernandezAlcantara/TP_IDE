@page "/atender/{reservaId:int}"
@page "/atender"
@using Domain.Model
@inject ReservaApiClient ReservaApiClient
@inject PracticaApiClient PracticaApiClient
@inject PacienteApiClient PacienteApiClient
@inject OdontologoApiClient OdontologoApiClient
@inject IBlazorAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Atender Reserva - Odontograma</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0 text-dark">
            <i class="bi bi-heart-pulse text-primary me-2"></i> Atender Reserva Odontológica
        </h1>
        <p class="text-muted small mb-0">Carga del Odontograma y prácticas realizadas en la sesión</p>
    </div>
    <a href="reservas" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver a Reservas
    </a>
</div>

@if (loading)
{
    <div class="card p-5 text-center border-0 shadow-sm">
        <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
        <p class="text-muted mb-0">Cargando datos de la atención...</p>
    </div>
}
else if (!autorizado)
{
    <div class="alert alert-warning">
        Solo odontólogos y administradores pueden acceder a la atención de reservas.
    </div>
}
else if (!reservaId.HasValue)
{
    <!-- LISTA DE RESERVAS A ATENDER (cuando se entra desde el menú sin elegir una) -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (pendientes.Count == 0)
    {
        <div class="card p-4 text-center text-muted border-0 shadow-sm">
            <i class="bi bi-calendar-check fs-2 mb-2"></i>
            No hay reservas pendientes de atención.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Turno(s)</th>
                        <th>Paciente</th>
                        @if (rolActual == "Administrador")
                        {
                            <th>Odontólogo</th>
                        }
                        <th>Cobertura</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pendientes)
                    {
                        <tr @key="p.Id">
                            <td class="small">
                                @if (p.Turnos.Count == 0)
                                {
                                    <span class="text-muted">Sin turno asignado</span>
                                }
                                else
                                {
                                    @foreach (var tu in p.Turnos)
                                    {
                                        <div>@tu.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm") hs</div>
                                    }
                                }
                            </td>
                            <td>@NombrePacienteLista(p._pacienteId)</td>
                            @if (rolActual == "Administrador")
                            {
                                <td>@p._odontologoMatricula</td>
                            }
                            <td>@p.ObraSocial</td>
                            <td><span class="badge bg-warning text-dark">@p.Estado</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-success" href="atender/@p.Id">
                                    <i class="bi bi-heart-pulse me-1"></i> Atender
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (reserva == null)
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>No se encontró la reserva #@reservaId. Puede que ya no exista.</span>
            <a href="atender" class="btn btn-sm btn-outline-secondary">Ver reservas pendientes</a>
        </div>
    }
}
else if (reserva.Estado == EstadoReserva.Completada || reserva.Estado == EstadoReserva.Cancelada)
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-lock-fill"></i>
        <div>
            Esta reserva está <strong>@reserva.Estado</strong> y no se puede volver a atender ni modificar.
            <a href="reservas" class="ms-2">Volver a reservas</a>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@errorMessage</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-check-circle-fill"></i>
            <div>@mensajeExito</div>
        </div>
    }

    <!-- INFORMACIÓN DEL PACIENTE Y LA RESERVA -->
    <div class="card border-0 shadow-sm p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <span class="text-muted small d-block">Paciente</span>
                <strong class="text-dark">@(paciente != null ? $"{paciente.Apellido}, {paciente.Nombre}" : $"Paciente #{reserva._pacienteId}")</strong>
                <div class="small text-muted">DNI: @(paciente?.NroDni.ToString() ?? "-")</div>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Odontólogo a cargo</span>
                <strong class="text-dark">@(odontologo != null ? $"{odontologo.Apellido}, {odontologo.Nombre}" : reserva._odontologoMatricula)</strong>
                <div class="small text-muted">Mat: @reserva._odontologoMatricula</div>
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Cobertura</span>
                <span class="badge @(reserva.ObraSocial == "Particular" ? "bg-secondary" : "bg-primary") px-2 py-1">
                    @reserva.ObraSocial
                </span>
                @if (!string.IsNullOrEmpty(reserva.NroAfiliado))
                {
                    <div class="small text-muted">Afil: @reserva.NroAfiliado</div>
                }
            </div>
            <div class="col-md-3">
                <span class="text-muted small d-block">Estado</span>
                <span class="badge bg-warning text-dark px-2 py-1">@reserva.Estado</span>
                <div class="small text-muted">Turno(s): @reserva.TurnosTexto</div>
                <div class="small text-muted">Motivo: @(reserva.Observaciones ?? "Consulta general")</div>
            </div>
        </div>
    </div>

    <!-- AREA DE ATENCIÓN    -->
    <div class="row g-4">
        <!-- COLUMNA IZQUIERDA: ODONTOGRAMA INTERACTIVO -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-diagram-3 text-primary me-2"></i> Odontograma Interactivo (32 Piezas)
                    </h5>
                    <button class="btn btn-outline-danger btn-sm" @onclick="LimpiarSeleccionDientes" disabled="@(carasSeleccionadas.Count == 0)">
                        <i class="bi bi-eraser me-1"></i> Desmarcar piezas
                    </button>
                </div>

                <p class="small text-muted mb-3">
                    Hacé clic sobre las caras (<strong>V</strong>: Vestibular, <strong>L</strong>: Lingual/Palatina, <strong>O</strong>: Oclusal, <strong>M</strong>: Mesial, <strong>D</strong>: Distal) de los dientes que quieras intervenir con la práctica seleccionada.
                </p>

                <div class="odontograma-container">
                    <!-- ARCADA SUPERIOR (Cuadrantes 1 y 2) -->
                    <div class="text-center small text-muted fw-bold mb-1">Arcada Superior (18 - 28)</div>
                    <div class="arcada-row">
                        @foreach (var diente in OdontogramaConstantes.Dientes.Take(16))
                        {
                            <div class="diente-card">
                                <span class="diente-numero">@diente</span>
                                <div class="diente-caras-grid">
                                    <button type="button" class="cara-btn cara-v @(IsCaraSelected(diente, "V") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "V")' title="Vestibular">
                                        V
                                    </button>
                                    <button type="button" class="cara-btn cara-m @(IsCaraSelected(diente, "M") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "M")' title="Mesial">
                                        M
                                    </button>
                                    <button type="button" class="cara-btn cara-o @(IsCaraSelected(diente, "O") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "O")' title="Oclusal">
                                        O
                                    </button>
                                    <button type="button" class="cara-btn cara-d @(IsCaraSelected(diente, "D") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "D")' title="Distal">
                                        D
                                    </button>
                                    <button type="button" class="cara-btn cara-l @(IsCaraSelected(diente, "L") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "L")' title="Lingual/Palatina">
                                        L
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- ARCADA INFERIOR (Cuadrantes 4 y 3) -->
                    <div class="text-center small text-muted fw-bold mb-1 mt-3">Arcada Inferior (48 - 38)</div>
                    <div class="arcada-row">
                        @foreach (var diente in OdontogramaConstantes.Dientes.Skip(16))
                        {
                            <div class="diente-card">
                                <span class="diente-numero">@diente</span>
                                <div class="diente-caras-grid">
                                    <button type="button" class="cara-btn cara-v @(IsCaraSelected(diente, "V") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "V")' title="Vestibular">
                                        V
                                    </button>
                                    <button type="button" class="cara-btn cara-m @(IsCaraSelected(diente, "M") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "M")' title="Mesial">
                                        M
                                    </button>
                                    <button type="button" class="cara-btn cara-o @(IsCaraSelected(diente, "O") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "O")' title="Oclusal">
                                        O
                                    </button>
                                    <button type="button" class="cara-btn cara-d @(IsCaraSelected(diente, "D") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "D")' title="Distal">
                                        D
                                    </button>
                                    <button type="button" class="cara-btn cara-l @(IsCaraSelected(diente, "L") ? "selected" : "")"
                                            @onclick='() => ToggleCara(diente, "L")' title="Lingual/Palatina">
                                        L
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- SELECCIONAR PRACTICA A AGREGAR -->
                <div class="mt-4 p-3 bg-light rounded-3 border">
                    <h6 class="fw-bold mb-3 text-dark">
                        <i class="bi bi-plus-circle text-success me-1"></i> Asignar Práctica al Odontograma
                    </h6>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Práctica a realizar *</label>
                            <select class="form-select form-select-sm" @bind="practicaCodigoSel" @bind:after="OnPracticaChanged">
                                <option value="0">- Seleccioná una práctica -</option>
                                @foreach (var p in practicas)
                                {
                                    <option value="@p.CodigoPractica">@p.Detalle ($@p.Precio)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Precio ($)</label>
                            <input type="number" step="100" class="form-control form-control-sm" @bind="precioPracticaSel" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Piezas afectadas:</label>
                            <div class="form-control form-control-sm bg-white text-truncate fw-bold text-primary">
                                @(carasSeleccionadas.Count > 0 ? StringFormateadoCaras : "Ninguna (Práctica general)")
                            </div>
                        </div>
                        <div class="col-12">
                            <input type="text" class="form-control form-control-sm" placeholder="Observaciones de la práctica (opcional)" @bind="observacionesPracticaSel" />
                        </div>
                        <div class="col-12 text-end">
                            <button type="button" class="btn btn-success btn-sm px-3" @onclick="AgregarPracticaALista">
                                <i class="bi bi-plus-lg me-1"></i> Agregar Práctica
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: RESUMEN DE PRÁCTICAS CARGADAS Y FINALIZAR -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 5rem;">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-clipboard-check text-primary me-2"></i> Prácticas en la Sesión
                </h5>

                @if (practicasCargadas.Count == 0)
                {
                    <div class="p-3 text-center text-muted border rounded-3 mb-3 bg-light">
                        <i class="bi bi-journal-plus fs-3 mb-1 d-block"></i>
                        Aún no agregaste ninguna práctica a esta atención.
                    </div>
                }
                else
                {
                    <ul class="list-unstyled mb-3">
                        @foreach (var (item, index) in practicasCargadas.Select((p, i) => (p, i)))
                        {
                            <li class="p-2 mb-2 bg-light border rounded-3 position-relative">
                                <div class="d-flex justify-content-between">
                                    <strong class="small text-dark">@GetPracticaDetalle(item.PracticaCodigo)</strong>
                                    <button class="btn btn-sm text-danger p-0" @onclick="() => practicasCargadas.RemoveAt(index)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <div class="small text-primary fw-semibold">
                                    <i class="bi bi-pin-angle me-1"></i> Piezas: @item.DientesCaras
                                </div>
                                <div class="d-flex justify-content-between small text-muted mt-1">
                                    <span>$@item.Precio</span>
                                    <span>@(string.IsNullOrEmpty(item.Observaciones) ? "" : item.Observaciones)</span>
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-between align-items-center py-2 border-top border-bottom mb-3">
                        <span class="fw-bold">Total Prácticas:</span>
                        <span class="fs-5 fw-bold text-success">$@practicasCargadas.Sum(p => p.Precio)</span>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Diagnóstico / Resultado final de la sesión *</label>
                    <textarea class="form-control" rows="3" placeholder="Detalle clínico de la atención realizada..." @bind="resultadoAtencion"></textarea>
                </div>

                <button class="btn btn-primary w-100 py-2 fw-semibold"
                        disabled="@(practicasCargadas.Count == 0 || guardando)"
                        @onclick="FinalizarAtencionAsync">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Guardando atención...</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Finalizar Atención y Guardar</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? reservaId { get; set; }

    private ReservaDTO? reserva;
    private PacienteDTO? paciente;
    private OdontologoDTO? odontologo;
    private List<PracticaDTO> practicas = new();

    private List<ReservaDTO> pendientes = new();
    private Dictionary<int, string> nombresPacientes = new();
    private string rolActual = string.Empty;

    private bool loading = true;
    private bool autorizado;
    private bool guardando = false;
    private string errorMessage = string.Empty;
    private string mensajeExito = string.Empty;

    // Formulario de Práctica actual
    private int practicaCodigoSel = 0;
    private float precioPracticaSel = 0;
    private string? observacionesPracticaSel;
    private HashSet<string> carasSeleccionadas = new(); // formato "14-M", "15-O"

    // Lista en memoria de prácticas realizadas
    private List<ReservaPracticaItemDTO> practicasCargadas = new();
    private string resultadoAtencion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        var token = await AuthService.GetTokenAsync();
        var rol = await AuthService.GetRolAsync();
        autorizado = rol == "Administrador" || rol == "Odontologo";
        rolActual = rol ?? string.Empty;

        if (!autorizado)
        {
            loading = false;
            return;
        }

        // Sin id: mostrar las reservas pendientes de atención (el API ya filtra por odontólogo)
        if (!reservaId.HasValue)
        {
            try
            {
                ReservaApiClient.SetToken(token);
                PacienteApiClient.SetToken(token);

                var rTask = ReservaApiClient.GetAllAsync();
                var pTask = PacienteApiClient.GetAllAsync();
                await Task.WhenAll(rTask, pTask);

                pendientes = (rTask.Result ?? new())
                    .Where(r => r.Estado == EstadoReserva.Pendiente)
                    .OrderBy(r => r.PrimerTurno ?? r.FechaCreacion)
                    .ToList();

                nombresPacientes = (pTask.Result ?? new())
                    .ToDictionary(p => p.NroPaciente, p => $"{p.Apellido}, {p.Nombre}");
            }
            catch (Exception ex)
            {
                errorMessage = "No se pudieron cargar las reservas: " + ex.Message;
            }
            finally
            {
                loading = false;
            }
            return;
        }

        try
        {
            ReservaApiClient.SetToken(token);
            PracticaApiClient.SetToken(token);
            PacienteApiClient.SetToken(token);
            OdontologoApiClient.SetToken(token);

            var rTask = ReservaApiClient.GetByIdAsync(reservaId.Value);
            var pTask = PracticaApiClient.GetAllAsync();

            await Task.WhenAll(rTask, pTask);

            reserva = rTask.Result;
            practicas = pTask.Result ?? new();

            if (reserva != null)
            {
                // Paciente y odontólogo en paralelo
                var paTask = PacienteApiClient.GetByNroPacienteAsync(reserva._pacienteId);
                var oTask = OdontologoApiClient.GetByMatriculaAsync(reserva._odontologoMatricula);
                await Task.WhenAll(paTask, oTask);
                paciente = paTask.Result;
                odontologo = oTask.Result;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar la atención: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private string NombrePacienteLista(int nro) =>
        nombresPacientes.TryGetValue(nro, out var n) ? n : $"Paciente #{nro}";

    private bool IsCaraSelected(int diente, string cara) =>
        carasSeleccionadas.Contains($"{diente}-{cara}");

    private void ToggleCara(int diente, string cara)
    {
        var key = $"{diente}-{cara}";
        if (!carasSeleccionadas.Add(key))
            carasSeleccionadas.Remove(key);
    }

    private void LimpiarSeleccionDientes()
    {
        carasSeleccionadas.Clear();
    }

    private string StringFormateadoCaras =>
        string.Join(", ", carasSeleccionadas.OrderBy(c => c));

    private void OnPracticaChanged()
    {
        var p = practicas.FirstOrDefault(x => x.CodigoPractica == practicaCodigoSel);
        if (p != null)
        {
            precioPracticaSel = p.Precio;
        }
    }

    private string GetPracticaDetalle(int codigo) =>
        practicas.FirstOrDefault(p => p.CodigoPractica == codigo)?.Detalle ?? $"Práctica #{codigo}";

    private void AgregarPracticaALista()
    {
        if (practicaCodigoSel <= 0)
        {
            errorMessage = "Seleccioná una práctica del listado.";
            return;
        }

        var item = new ReservaPracticaItemDTO
        {
            PracticaCodigo = practicaCodigoSel,
            DientesCaras = carasSeleccionadas.Count > 0 ? StringFormateadoCaras : "General",
            Precio = precioPracticaSel,
            Observaciones = observacionesPracticaSel
        };

        practicasCargadas.Add(item);

        // Reset para la siguiente práctica
        carasSeleccionadas.Clear();
        observacionesPracticaSel = null;
        errorMessage = string.Empty;
    }

    private static string? ExtraerMensaje(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object &&
                doc.RootElement.TryGetProperty("error", out var e))
                return e.GetString();
        }
        catch { }
        return json;
    }

    private async Task FinalizarAtencionAsync()
    {
        if (practicasCargadas.Count == 0)
        {
            errorMessage = "Tenés que agregar al menos una práctica a la atención.";
            return;
        }

        if (string.IsNullOrWhiteSpace(resultadoAtencion))
        {
            errorMessage = "Ingresá el diagnóstico o resultado clínico de la sesión.";
            return;
        }

        guardando = true;
        errorMessage = string.Empty;

        try
        {
            var dto = new AtenderReservaDTO
            {
                ReservaId = reservaId!.Value,
                Resultado = resultadoAtencion,
                ImporteTotal = practicasCargadas.Sum(p => p.Precio),
                Practicas = practicasCargadas
            };

            var (ok, error) = await ReservaApiClient.AtenderReservaAsync(dto);
            if (ok)
            {
                mensajeExito = "¡Atención guardada y reserva completada con éxito!";
                await Task.Delay(1500);
                Navigation.NavigateTo("reservas");
            }
            else
            {
                errorMessage = ExtraerMensaje(error) ?? "No se pudo finalizar la atención.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error inesperado: " + ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }
}