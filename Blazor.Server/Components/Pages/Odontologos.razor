@page "/odontologos"
@inject OdontologoApiClient OdontologoApiClient
@inject IBlazorAuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Odontólogos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Odontólogos</h1>
    @if (autorizado)
    {
        <button class="btn btn-primary" @onclick="() => modal.ShowAddModal()">Agregar odontólogo</button>
    }
</div>

@if (loading)
{
    <p><em>Cargando odontólogos...</em></p>
}
else if (!autorizado)
{
    <div class="alert alert-warning">
        Esta sección es solo para administradores. Iniciá sesión con una cuenta de administrador para verla.
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (odontologos.Count == 0)
{
    <p>Todavía no hay odontólogos cargados. Usá "Agregar odontólogo" para crear el primero.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Matrícula</th>
                    <th>Apellido y nombre</th>
                    <th>Documento</th>
                    <th>Especialidad</th>
                    <th>Email</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in odontologos)
                {
                    <tr @key="o.Matricula">
                        <td>@o.Matricula</td>
                        <td>@o.Apellido, @o.Nombre</td>
                        <td>@o.TipoDocumento @o.NroDocumento</td>
                        <td>@o.Especialidad</td>
                        <td>@o.Email</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => modal.ShowEditModal(o)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarAsync(o)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<OdontologoModal @ref="modal" OnOdontologoChanged="CargarOdontologosAsync" />

@code {
    private OdontologoModal modal = default!;
    private List<OdontologoDTO> odontologos = new();
    private bool loading = true;
    private bool autorizado = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rol = await AuthService.GetRolAsync();
            autorizado = rol == "Administrador";

            if (autorizado)
                await CargarOdontologosAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error al cargar los odontólogos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CargarOdontologosAsync()
    {
        errorMessage = string.Empty;

        try
        {
            OdontologoApiClient.SetToken(await AuthService.GetTokenAsync());
            var resultado = await OdontologoApiClient.GetAllAsync();

            if (resultado is null)
            {
                errorMessage = "No se pudieron cargar los odontólogos. Verificá que el WebAPI esté corriendo y que tu sesión siga activa.";
                return;
            }

            odontologos = resultado.OrderBy(o => o.Apellido).ThenBy(o => o.Nombre).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error al cargar los odontólogos: {ex.Message}";
        }
    }

    private async Task EliminarAsync(OdontologoDTO odontologo)
    {
        try
        {
            bool confirmar = await JSRuntime.InvokeAsync<bool>(
                "confirm", $"¿Eliminar a {odontologo.Apellido}, {odontologo.Nombre}? Esta acción no se puede deshacer.");

            if (!confirmar)
                return;

            OdontologoApiClient.SetToken(await AuthService.GetTokenAsync());

            if (await OdontologoApiClient.EliminarAsync(odontologo.Matricula))
                await CargarOdontologosAsync();
            else
                errorMessage = "No se pudo eliminar el odontólogo. Puede tener turnos o reservas asociadas.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error al eliminar: {ex.Message}";
        }
    }

}