@page "/mutuales"
@inject MutualApiClient MutualApiClient
@inject IBlazorAuthService AuthService

<PageTitle>Mutuales</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Mutuales</h3>
    <button class="btn btn-primary" @onclick="NuevaMutual">+ Nueva mutual</button>
</div>

<div class="mb-3">
    <input type="text" class="form-control" placeholder="Buscar por nombre o CUIT..."
           @bind="filtro" @bind:event="oninput" />
</div>

@if (!string.IsNullOrEmpty(mensajeOk))
{
    <div class="alert alert-success alert-dismissible">
        @mensajeOk
        <button type="button" class="btn-close" @onclick="() => mensajeOk = string.Empty"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

@if (loading)
{
    <div class="text-center my-4">
        <span class="spinner-border"></span>
    </div>
}
else if (MutualesFiltradas.Count == 0)
{
    <p class="text-muted">@(string.IsNullOrWhiteSpace(filtro) ? "No hay mutuales cargadas." : "No hay mutuales que coincidan con la búsqueda.")</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>CUIT</th>
                <th>Nombre</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in MutualesFiltradas)
            {
                <tr>
                    <td>@m.Cuit</td>
                    <td>@m.Nombre</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarMutual(m)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirConfirmacion(m)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<MutualModal @ref="mutualModal" OnMutualChanged="OnMutualChanged" />

@* Confirmación de baja *@
@if (mutualAEliminar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar mutual</h5>
                    <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    ¿Seguro que querés eliminar la mutual <strong>@mutualAEliminar.Nombre</strong> (CUIT @mutualAEliminar.Cuit)?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                    <button type="button" class="btn btn-danger" disabled="@eliminando" @onclick="ConfirmarEliminar">
                        @if (eliminando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private MutualModal mutualModal = default!;
    private List<MutualDTO> mutuales = new();
    private string filtro = string.Empty;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string mensajeOk = string.Empty;

    private MutualDTO? mutualAEliminar;
    private bool eliminando = false;

    private List<MutualDTO> MutualesFiltradas =>
        string.IsNullOrWhiteSpace(filtro)
            ? mutuales
            : mutuales.Where(m =>
                    m.Nombre.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase) ||
                    m.Cuit.ToString().Contains(filtro.Trim()))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarMutuales();
    }

    private async Task CargarMutuales()
    {
        try
        {
            loading = true;
            MutualApiClient.SetToken(await AuthService.GetTokenAsync());

            var resultado = await MutualApiClient.GetAllAsync();
            if (resultado == null)
            {
                errorMessage = "No se pudieron cargar las mutuales. Volvé a iniciar sesión.";
                mutuales = new();
                return;
            }

            mutuales = resultado.OrderBy(m => m.Nombre).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task NuevaMutual()
    {
        mensajeOk = string.Empty;
        await mutualModal.ShowCreateModal();
    }

    private async Task EditarMutual(MutualDTO mutual)
    {
        mensajeOk = string.Empty;
        await mutualModal.ShowEditModal(mutual);
    }

    private async Task OnMutualChanged()
    {
        mensajeOk = "Mutual guardada correctamente.";
        errorMessage = string.Empty;
        await CargarMutuales();
    }

    private void PedirConfirmacion(MutualDTO mutual)
    {
        mensajeOk = string.Empty;
        errorMessage = string.Empty;
        mutualAEliminar = mutual;
    }

    private void CancelarEliminar()
    {
        mutualAEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        if (mutualAEliminar == null)
            return;

        try
        {
            eliminando = true;
            MutualApiClient.SetToken(await AuthService.GetTokenAsync());

            var (ok, error) = await MutualApiClient.EliminarAsync(mutualAEliminar.Cuit);
            if (!ok)
            {
                errorMessage = error ?? "No se pudo eliminar la mutual.";
                return;
            }

            mensajeOk = $"Mutual \"{mutualAEliminar.Nombre}\" eliminada.";
            await CargarMutuales();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            eliminando = false;
            mutualAEliminar = null;
        }
    }
}
