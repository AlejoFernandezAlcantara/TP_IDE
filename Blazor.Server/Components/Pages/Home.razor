@page "/"
@inject IBlazorAuthService AuthService

<PageTitle>Inicio - Consultorio Carestia</PageTitle>

<div class="container-fluid px-0">
    <!-- Hero Banner -->
    <div class="card border-0 rounded-4 p-4 p-md-5 mb-4 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-white text-primary fw-semibold px-3 py-2 rounded-pill mb-3">
                    <i class="bi bi-star-fill text-warning me-1"></i> Consultorio Carestia
                </span>
                <h1 class="display-6 fw-bold text-white mb-2">Bienvenido a Consultorio Carestia</h1>
                <p class="lead opacity-90 mb-4" style="font-size: 1.1rem;">
                    Sistema integral para la gestión de turnos, historias clínicas, odontogramas y atención médica de excelencia.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="reservar" class="btn btn-light fw-semibold text-primary px-4 py-2">
                        <i class="bi bi-calendar-plus me-1"></i> Reservar Turno
                    </a>
                    @if (rol == "Administrador")
                    {
                        <a href="pacientes" class="btn btn-outline-light px-4 py-2">
                            <i class="bi bi-people me-1"></i> Administrar Pacientes
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <img src="images/logo-gold-light.png" alt="Consultorio Carestia" class="img-fluid" style="max-height: 160px; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));" />
            </div>
        </div>
    </div>

    <!-- Quick Stats & Highlights -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
            <div class="card h-100 card-hover p-4 border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-1">Turnos Online</h6>
                        <h4 class="fw-bold mb-0">Gestión Dinámica</h4>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    Disponibilidad en tiempo real para pacientes y profesionales en todas las especialidades.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 card-hover p-4 border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-clipboard2-pulse fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-1">Odontogramas</h6>
                        <h4 class="fw-bold mb-0">32 Piezas Dentales</h4>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    Registro de caries, restauraciones y diagnósticos por cara y diente anatómico.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 card-hover p-4 border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info-subtle text-info-emphasis p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small text-uppercase fw-semibold mb-1">Coberturas</h6>
                        <h4 class="fw-bold mb-0">Mutuales y Obras</h4>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    Convenios con OSDE, Swiss Medical, Galeno, Medifé, IOMA y PAMI.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private string? rol;

    protected override async Task OnInitializedAsync()
    {
        rol = await AuthService.GetRolAsync();
    }
}
