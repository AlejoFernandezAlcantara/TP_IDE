@page "/reservar"
@using Domain.Model
@inject TurnoApiClient TurnoApiClient
@inject OdontologoApiClient OdontologoApiClient
@inject PacienteApiClient PacienteApiClient
@inject MutualApiClient MutualApiClient
@inject IBlazorAuthService AuthService

<PageTitle>Reservar turnos</PageTitle>

<h1 class="mb-3">@(rol == "Paciente" ? "Reservar turno" : "Nueva reserva")</h1>

@if (loading)
{
    <p><em>Cargando datos...</em></p>
}
else if (!autorizado)
{
    <div class="alert alert-warning">
        Iniciá sesión para reservar turnos.
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-check-circle-fill me-2"></i> @mensaje
            </div>
            <a class="btn btn-sm btn-outline-success" href="@(rol == "Paciente" ? "mis-reservas" : "reservas")">Ver reservas</a>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" style="white-space: pre-line;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }

    <!-- FILTROS Y DATOS DE LA RESERVA -->
    <div class="card p-4 mb-4 border-0 shadow-sm">
        <h5 class="card-title fw-bold text-dark mb-3">
            <i class="bi bi-card-checklist text-primary me-2"></i> Datos de la Cobertura y Reserva
        </h5>

        <div class="row g-3">
            @if (rol != "Paciente")
            {
                <div class="col-md-6">
                    <label class="form-label">Buscar paciente</label>
                    <input type="text" class="form-control" placeholder="Apellido, nombre o DNI"
                           @bind="busquedaPaciente" @bind:event="oninput" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Paciente *</label>
                    <select class="form-select" @bind="pacienteSel">
                        <option value="0">- Elegí un paciente -</option>
                        @foreach (var p in PacientesFiltrados)
                        {
                            <option value="@p.NroPaciente">@p.Apellido, @p.Nombre (DNI @p.NroDni)</option>
                        }
                    </select>
                </div>
            }

            <!-- SELECCION DE OBRA SOCIAL Y NRO AFILIADO CONDICIONAL -->
            <div class="col-md-6">
                <label class="form-label fw-semibold">Obra Social / Cobertura *</label>
                <select class="form-select" @bind="obraSocialSel">
                    <option value="Particular">Particular (Sin obra social)</option>
                    @foreach (var m in mutuales)
                    {
                        <option value="@m.Nombre">@m.Nombre</option>
                    }
                </select>
                <small class="text-muted">Seleccioná si el paciente se atiende de forma particular o por obra social.</small>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Número de Afiliado @(obraSocialSel != "Particular" ? "*" : "")</label>
                <input type="text" class="form-control" 
                       placeholder="@(obraSocialSel == "Particular" ? "No requerido para Particular" : "Ej: 123456789/01")"
                       disabled="@(obraSocialSel == "Particular")"
                       @bind="nroAfiliado" />
                @if (obraSocialSel != "Particular")
                {
                    <small class="text-primary">Obligatorio para presentar a la obra social seleccionada.</small>
                }
            </div>

            @if (!EsOdontologo)
            {
                <div class="col-md-4 mt-3">
                    <label class="form-label">Filtrar Odontólogo</label>
                    <select class="form-select" @bind="matriculaFiltro">
                        <option value="">Todos</option>
                        @foreach (var o in odontologos)
                        {
                            <option value="@o.Matricula">@o.Apellido, @o.Nombre - @o.Especialidad</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-4 mt-3">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" @bind="filtroDesde" />
            </div>
            <div class="col-md-4 mt-3">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="filtroHasta" />
            </div>
        </div>
    </div>

    <!-- SELECCION DE TURNOS -->
    <div class="row">
        <div class="col-lg-8">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-clock-history text-primary me-2"></i> Turnos disponibles
            </h5>

            @if (TurnosFiltrados.Count == 0)
            {
                <div class="card p-4 text-center text-muted border-0 shadow-sm">
                    <i class="bi bi-calendar-x fs-2 mb-2"></i>
                    No hay turnos disponibles para los filtros seleccionados.
                </div>
            }
            else
            {
                @foreach (var grupo in PorDia)
                {
                    <div class="card p-3 mb-3 border-0 shadow-sm">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="bi bi-calendar-event text-secondary me-1"></i>
                            @NombreDia(grupo.Key.DayOfWeek) @grupo.Key.ToString("dd/MM/yyyy")
                        </h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var t in grupo)
                            {
                                var turno = t;
                                <button type="button"
                                        class="btn btn-sm @(seleccion.Contains(turno.Codigo) ? "btn-primary shadow" : "btn-outline-primary")"
                                        @onclick="() => Toggle(turno.Codigo)">
                                    <i class="bi @(seleccion.Contains(turno.Codigo) ? "bi-check-circle" : "bi-clock") me-1"></i>
                                    @turno.FechaHoraInicio.ToString("HH:mm") · @NombreOdontologo(turno._odontologoMatricula)
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 5rem;">
                <h5 class="fw-bold mb-3">Resumen de la reserva</h5>

                <div class="mb-3">
                    <span class="text-muted small d-block">Cobertura seleccionada:</span>
                    <span class="fw-bold text-primary">@obraSocialSel</span>
                    @if (obraSocialSel != "Particular" && !string.IsNullOrWhiteSpace(nroAfiliado))
                    {
                        <span class="badge bg-secondary ms-1">Afil: @nroAfiliado</span>
                    }
                </div>

                @if (seleccion.Count == 0)
                {
                    <p class="text-muted small">Elegí uno o más turnos de la lista para reservarlos juntos.</p>
                }
                else
                {
                    <p class="small text-muted mb-2">Turnos seleccionados (<strong>@seleccion.Count</strong>):</p>
                    <ul class="list-unstyled mb-3">
                        @foreach (var t in TurnosSeleccionados)
                        {
                            <li class="mb-2 p-2 bg-light rounded d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold small">@t.FechaHoraInicio.ToString("dd/MM HH:mm") hs</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@NombreOdontologo(t._odontologoMatricula)</div>
                                </div>
                                <button class="btn btn-sm text-danger p-0" @onclick="() => seleccion.Remove(t.Codigo)">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </li>
                        }
                    </ul>
                }

                <button class="btn btn-primary w-100 py-2 fw-semibold"
                        disabled="@(seleccion.Count == 0 || procesando)"
                        @onclick="ReservarAsync">
                    @if (procesando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Confirmando...</span>
                    }
                    else
                    {
                        <span>Confirmar Reserva</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<TurnoDTO> turnos = new();
    private List<OdontologoDTO> odontologos = new();
    private List<PacienteDTO> pacientes = new();
    private List<MutualDTO> mutuales = new();
    private Dictionary<string, OdontologoDTO> odontologosPorMatricula = new();

    private HashSet<int> seleccion = new();

    private string? rol;
    private string? matriculaPropia;
    private int? nroPacienteToken;
    private bool autorizado;
    private bool loading = true;
    private bool procesando = false;
    private string mensaje = string.Empty;
    private string errorMessage = string.Empty;

    // Filtros
    private string busquedaPaciente = string.Empty;
    private int pacienteSel = 0;
    private string matriculaFiltro = string.Empty;
    private DateTime? filtroDesde = DateTime.Today;
    private DateTime? filtroHasta;

    // Obra social
    private string obraSocialSel = "Particular";
    private string? nroAfiliado;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        loading = true;
        errorMessage = string.Empty;

        var token = await AuthService.GetTokenAsync();
        rol = await AuthService.GetRolAsync();
        nroPacienteToken = await AuthService.GetNroPacienteAsync();
        matriculaPropia = TokenClaims.Matricula(token) ?? await AuthService.GetMatriculaAsync();
        autorizado = !string.IsNullOrEmpty(rol);

        if (!autorizado)
        {
            loading = false;
            return;
        }

        try
        {
            TurnoApiClient.SetToken(token);
            OdontologoApiClient.SetToken(token);
            PacienteApiClient.SetToken(token);
            MutualApiClient.SetToken(token);

            var tTask = TurnoApiClient.GetAllAsync();
            var oTask = OdontologoApiClient.GetAllAsync();
            var mTask = MutualApiClient.GetAllAsync();

            await Task.WhenAll(tTask, oTask, mTask);

            turnos = tTask.Result ?? new();
            odontologos = oTask.Result ?? new();
            mutuales = mTask.Result ?? new();
            odontologosPorMatricula = odontologos.ToDictionary(o => o.Matricula, StringComparer.OrdinalIgnoreCase);

            if (rol != "Paciente")
            {
                pacientes = await PacienteApiClient.GetAllAsync() ?? new();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudieron cargar los datos: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private IEnumerable<PacienteDTO> PacientesFiltrados =>
        string.IsNullOrWhiteSpace(busquedaPaciente)
            ? pacientes
            : pacientes.Where(p =>
                (p.Apellido?.Contains(busquedaPaciente, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Nombre?.Contains(busquedaPaciente, StringComparison.OrdinalIgnoreCase) ?? false) ||
                p.NroDni.ToString().Contains(busquedaPaciente));

    private bool EsOdontologo => rol == "Odontologo";

    // Solo turnos DISPONIBLES y futuros. El odontólogo únicamente ve sus propios turnos.
    private List<TurnoDTO> TurnosFiltrados =>
        turnos
            .Where(t => t.Estado == EstadoTurno.Disponible)
            .Where(t => t.FechaHoraInicio > DateTime.Now)
            .Where(t => !EsOdontologo || string.Equals(t._odontologoMatricula, matriculaPropia, StringComparison.OrdinalIgnoreCase))
            .Where(t => string.IsNullOrEmpty(matriculaFiltro) || t._odontologoMatricula == matriculaFiltro)
            .Where(t => !filtroDesde.HasValue || t.FechaHoraInicio.Date >= filtroDesde.Value.Date)
            .Where(t => !filtroHasta.HasValue || t.FechaHoraInicio.Date <= filtroHasta.Value.Date)
            .OrderBy(t => t.FechaHoraInicio)
            .ToList();

    private IEnumerable<IGrouping<DateTime, TurnoDTO>> PorDia =>
        TurnosFiltrados.GroupBy(t => t.FechaHoraInicio.Date);

    private List<TurnoDTO> TurnosSeleccionados =>
        turnos.Where(t => seleccion.Contains(t.Codigo)).OrderBy(t => t.FechaHoraInicio).ToList();

    private void Toggle(int codigo)
    {
        errorMessage = string.Empty;

        if (seleccion.Remove(codigo))
            return;

        // Todos los turnos de una misma reserva deben ser del mismo odontólogo
        var nuevo = turnos.FirstOrDefault(t => t.Codigo == codigo);
        var actual = TurnosSeleccionados.FirstOrDefault();
        if (nuevo != null && actual != null && nuevo._odontologoMatricula != actual._odontologoMatricula)
        {
            errorMessage = "Una reserva solo puede incluir turnos de un mismo odontólogo. Confirmá la actual y creá otra reserva para el otro profesional.";
            return;
        }

        seleccion.Add(codigo);
    }

    private async Task ReservarAsync()
    {
        mensaje = string.Empty;
        errorMessage = string.Empty;

        // Validaciones
        int pacienteId;
        if (rol == "Paciente")
        {
            pacienteId = nroPacienteToken ?? 0;
        }
        else
        {
            if (pacienteSel <= 0)
            {
                errorMessage = "Elegí el paciente para el que se reserva.";
                return;
            }
            pacienteId = pacienteSel;
        }

        if (obraSocialSel != "Particular" && string.IsNullOrWhiteSpace(nroAfiliado))
        {
            errorMessage = $"El Número de Afiliado es obligatorio si seleccionás la obra social {obraSocialSel}.";
            return;
        }

        var aReservar = TurnosSeleccionados;
        if (aReservar.Count == 0)
            return;

        procesando = true;
        TurnoApiClient.SetToken(await AuthService.GetTokenAsync());

        var request = new ReservarTurnosDTO
        {
            PacienteId = pacienteId,
            TurnoCodigos = aReservar.Select(t => t.Codigo).ToList(),
            ObraSocial = obraSocialSel,
            NroAfiliado = obraSocialSel == "Particular" ? null : nroAfiliado
        };

        var (ok, error) = await TurnoApiClient.ReservarVariosAsync(request);

        procesando = false;

        if (ok)
        {
            mensaje = aReservar.Count == 1
                ? "¡Turno reservado con éxito!"
                : $"¡Reserva creada con {aReservar.Count} turnos!";
            seleccion.Clear();
            if (obraSocialSel == "Particular")
            {
                nroAfiliado = null;
            }
        }
        else
        {
            errorMessage = error ?? "No se pudo reservar el turno.";
        }

        await CargarAsync();
    }

    private string NombreOdontologo(string matricula)
        => odontologosPorMatricula.TryGetValue(matricula, out var o) ? $"{o.Apellido}, {o.Nombre}" : matricula;

    private static string NombreDia(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Lun",
        DayOfWeek.Tuesday => "Mar",
        DayOfWeek.Wednesday => "Mié",
        DayOfWeek.Thursday => "Jue",
        DayOfWeek.Friday => "Vie",
        DayOfWeek.Saturday => "Sáb",
        _ => "Dom"
    };
}