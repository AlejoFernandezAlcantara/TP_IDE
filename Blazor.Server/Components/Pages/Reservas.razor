@page "/reservas"
@using Domain.Model
@inject ReservaApiClient ReservaApiClient
@inject TurnoApiClient TurnoApiClient
@inject PacienteApiClient PacienteApiClient
@inject OdontologoApiClient OdontologoApiClient
@inject IBlazorAuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Reservas</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@(rol == "Odontologo" ? "Mis reservas" : "Reservas")</h1>
    @if (mostrar)
    {
        <a class="btn btn-primary" href="reservar">
            <i class="bi bi-plus-circle me-1"></i> Nueva reserva
        </a>
    }
</div>

@if (loading)
{
    <p><em>Cargando reservas...</em></p>
}

@if (!loading && !autorizado)
{
    <div class="alert alert-warning">
        Esta sección es solo para administradores y odontólogos. Iniciá sesión con una cuenta habilitada.
    </div>
}

@if (mostrar)
{
    <div class="card p-3 mb-3 border-0 shadow-sm" style="max-width: 320px;">
        <label class="form-label small fw-semibold">Filtrar por estado</label>
        <select class="form-select form-select-sm" @bind="filtroEstado">
            <option value="">Todos los estados</option>
            <option value="@EstadoReserva.Pendiente">Pendiente</option>
            <option value="@EstadoReserva.Completada">Completada (Terminada)</option>
            <option value="@EstadoReserva.Cancelada">Cancelada</option>
        </select>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-success d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i>
            <div>@mensaje</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@errorMessage</div>
        </div>
    }

    @if (Filtradas.Count == 0)
    {
        <div class="card p-4 text-center text-muted border-0 shadow-sm">
            No hay reservas para mostrar con el filtro actual.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Fecha y hora del turno</th>
                        <th>Paciente</th>
                        @if (rol == "Administrador")
                        {
                            <th>Odontólogo</th>
                        }
                        <th>Cobertura</th>
                        <th>Estado</th>
                        <th>Importe</th>
                        <th>Historial / Prácticas Realizadas</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Filtradas)
                    {
                        <tr @key="r.Id">
                            <td>
                                @if (r.Turnos.Count > 0)
                                {
                                    @foreach (var tu in r.Turnos)
                                    {
                                        <div class="fw-semibold small">
                                            @tu.FechaHoraInicio.ToString("dd/MM/yyyy")
                                            <span class="text-muted fw-normal">@tu.FechaHoraInicio.ToString("HH:mm") hs</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small"><em>Sin turno asignado</em></div>
                                }
                                <div class="text-muted" style="font-size: 0.7rem;">Reservada el @r.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-bold">@NombrePaciente(r._pacienteId)</div>
                                <small class="text-muted">ID: #@r._pacienteId</small>
                            </td>
                            @if (rol == "Administrador")
                            {
                                <td>@NombreOdontologo(r._odontologoMatricula)</td>
                            }
                            <td>
                                <span class="badge @(r.ObraSocial == "Particular" ? "bg-secondary" : "bg-primary")">
                                    @r.ObraSocial
                                </span>
                                @if (!string.IsNullOrEmpty(r.NroAfiliado))
                                {
                                    <div class="small text-muted" style="font-size: 0.75rem;">Af: @r.NroAfiliado</div>
                                }
                            </td>
                            <td><span class="badge @ClaseEstado(r.Estado)">@r.Estado</span></td>
                            <td>
                                <strong>@(r.Importe.HasValue ? $"$ {r.Importe.Value:N2}" : "-")</strong>
                            </td>
                            <td>
                                @if (r.Estado == EstadoReserva.Completada)
                                {
                                    @if (r.PracticasRealizadas != null && r.PracticasRealizadas.Count > 0)
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var p in r.PracticasRealizadas)
                                            {
                                                <div class="small bg-white p-1 px-2 border rounded shadow-xs">
                                                    <strong class="text-dark">@(p.PracticaDetalle ?? $"Práctica #{p.PracticaCodigo}")</strong>
                                                    - Piezas: <span class="badge bg-danger-subtle text-danger fw-bold">@p.DientesCaras</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="small text-muted"><em>@r.Resultado</em></span>
                                    }
                                }
                                else
                                {
                                    <span class="small text-muted">@(r.Observaciones ?? "En espera de atención")</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (r.Estado == EstadoReserva.Pendiente)
                                {
                                    <a class="btn btn-sm btn-success me-1 shadow-sm" href="atender/@r.Id" title="Abrir Odontograma y Atender">
                                        <i class="bi bi-heart-pulse me-1"></i> Atender
                                    </a>
                                }
                                @if (r.Estado != EstadoReserva.Cancelada && r.Estado != EstadoReserva.Completada)
                                {
                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => CancelarAsync(r)">
                                        Cancelar
                                    </button>
                                }
                                @if (r.Estado == EstadoReserva.Completada)
                                {
                                    <span class="badge bg-light text-secondary border" title="Una reserva atendida no se puede editar ni eliminar">
                                        <i class="bi bi-lock-fill me-1"></i> Atendida
                                    </span>
                                }
                                else if (rol == "Administrador" && r.Estado == EstadoReserva.Cancelada)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarAsync(r)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private string rol = string.Empty;
    private bool loading = true;
    private bool autorizado = false;
    private string filtroEstado = string.Empty;
    private List<ReservaDTO> reservas = new();
    private Dictionary<int, PacienteDTO> pacientes = new();
    private Dictionary<string, OdontologoDTO> odontologos = new();
    private string mensaje = string.Empty;
    private string errorMessage = string.Empty;

    private bool mostrar => !loading && autorizado;

    private List<ReservaDTO> Filtradas =>
        string.IsNullOrEmpty(filtroEstado)
            ? reservas
            : reservas.Where(r => r.Estado.ToString() == filtroEstado).ToList();

    protected override async Task OnInitializedAsync()
    {
        rol = await AuthService.GetRolAsync() ?? string.Empty;
        autorizado = rol == "Administrador" || rol == "Odontologo";

        if (autorizado)
        {
            await CargarAsync();
        }
        else
        {
            loading = false;
        }
    }

    private async Task CargarAsync(bool mostrarCarga = true)
    {
        if (mostrarCarga)
            loading = true;
        errorMessage = string.Empty;

        var token = await AuthService.GetTokenAsync();
        ReservaApiClient.SetToken(token);
        PacienteApiClient.SetToken(token);
        OdontologoApiClient.SetToken(token);

        try
        {
            var rTask = ReservaApiClient.GetAllAsync();
            var pTask = PacienteApiClient.GetAllAsync();
            var oTask = OdontologoApiClient.GetAllAsync();

            await Task.WhenAll(rTask, pTask, oTask);

            reservas = (rTask.Result ?? new()).OrderByDescending(r => r.PrimerTurno ?? r.FechaCreacion).ToList();

            var pList = pTask.Result ?? new();
            pacientes = pList.ToDictionary(p => p.NroPaciente);

            var oList = oTask.Result ?? new();
            odontologos = oList.ToDictionary(o => o.Matricula, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudieron cargar las reservas: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CancelarAsync(ReservaDTO r)
    {
        bool confirmar = await JSRuntime.InvokeAsync<bool>(
            "confirm", $"¿Cancelar la reserva de {NombrePaciente(r._pacienteId)}?");
        if (!confirmar)
            return;

        if (r.Estado == EstadoReserva.Completada)
        {
            errorMessage = "Una reserva atendida no se puede editar ni eliminar.";
            return;
        }

        r.Estado = EstadoReserva.Cancelada;
        var (ok, error) = await ReservaApiClient.ActualizarAsync(r);
        if (ok)
        {
            mensaje = "Reserva cancelada.";
            errorMessage = string.Empty;
        }
        else
        {
            errorMessage = error ?? "No se pudo cancelar la reserva.";
        }

        // Refresco sin ocultar la tabla y redibujado explícito al terminar
        await CargarAsync(mostrarCarga: false);
        StateHasChanged();
    }

    private async Task EliminarAsync(ReservaDTO r)
    {
        bool confirmar = await JSRuntime.InvokeAsync<bool>(
            "confirm", $"¿Eliminar definitivamente la reserva #{r.Id}?");
        if (!confirmar)
            return;

        if (r.Estado == EstadoReserva.Completada)
        {
            errorMessage = "Una reserva atendida no se puede editar ni eliminar.";
            return;
        }

        var (ok, error) = await ReservaApiClient.EliminarAsync(r.Id);
        if (ok)
        {
            mensaje = "Reserva eliminada.";
            errorMessage = string.Empty;
            await CargarAsync(mostrarCarga: false);
            StateHasChanged();
        }
        else
        {
            errorMessage = error ?? "No se pudo eliminar la reserva.";
        }
    }

    private string NombrePaciente(int nro)
        => pacientes.TryGetValue(nro, out var p) ? $"{p.Apellido}, {p.Nombre}" : $"Paciente #{nro}";

    private string NombreOdontologo(string matricula)
        => odontologos.TryGetValue(matricula, out var o) ? $"{o.Apellido}, {o.Nombre}" : matricula;

    private static string ClaseEstado(EstadoReserva estado) => estado switch
    {
        EstadoReserva.Pendiente => "bg-warning text-dark",
        EstadoReserva.Completada => "bg-success",
        EstadoReserva.Cancelada => "bg-secondary",
        _ => "bg-light text-dark"
    };
}