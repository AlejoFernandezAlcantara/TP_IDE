@page "/pacientes"
@inject PacienteApiClient PacienteApiClient
@inject IBlazorAuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Pacientes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Pacientes</h1>
    @if (autorizado)
    {
        <button class="btn btn-primary" @onclick="() => modal.ShowAddModal()">Agregar paciente</button>
    }
</div>

@if (loading)
{
    <p><em>Cargando pacientes...</em></p>
}
else if (!autorizado)
{
    <div class="alert alert-warning">
        Esta sección es solo para administradores y odontólogos. Iniciá sesión con una cuenta autorizada para verla.
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    @if (!esAdmin)
    {
        <div class="alert alert-info small py-2">
            Podés registrar pacientes nuevos. La edición y eliminación de pacientes son solo para administradores.
        </div>
    }

    <div class="card p-3 mb-3 border-0 shadow-sm bg-light">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Buscar paciente</label>
                <input type="text" class="form-control form-control-sm" placeholder="Nombre, apellido, DNI o email..."
                       @bind="filtroBusqueda" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                @if (!string.IsNullOrWhiteSpace(filtroBusqueda))
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => { filtroBusqueda = string.Empty; paginaActual = 1; }">
                        <i class="bi bi-x-circle me-1"></i> Limpiar
                    </button>
                }
            </div>
        </div>
    </div>

    @if (PacientesFiltrados.Count == 0)
    {
        <div class="card p-4 text-center text-muted border-0 shadow-sm">
            No se encontraron pacientes con los criterios indicados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nº</th>
                        <th>Apellido y nombre</th>
                        <th>Documento</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        @if (esAdmin)
                        {
                            <th class="text-end">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in PaginaActualPacientes)
                    {
                        <tr @key="p.NroPaciente">
                            <td>@p.NroPaciente</td>
                            <td>@p.Apellido, @p.Nombre</td>
                            <td>@p.TipoDni @p.NroDni</td>
                            <td>@p.Email</td>
                            <td>@p.Telefono</td>
                            <td>@p.Direccion</td>
                            @if (esAdmin)
                            {
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => modal.ShowEditModal(p)">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarAsync(p)">Eliminar</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Paginador TotalItems="@PacientesFiltrados.Count"
                   @bind-PaginaActual="paginaActual"
                   @bind-PageSize="pageSize" />
    }
}

<PacienteModal @ref="modal" OnPacienteChanged="CargarPacientesAsync" />

@code {
    private PacienteModal modal = default!;
    private List<PacienteDTO> pacientes = new();
    private bool loading = true;
    private bool autorizado = false;
    private bool esAdmin = false;
    private string errorMessage = string.Empty;

    private string filtroBusqueda = string.Empty;
    private int paginaActual = 1;
    private int pageSize = 10;

    private List<PacienteDTO> PacientesFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroBusqueda))
                return pacientes;

            var busq = filtroBusqueda.Trim();
            return pacientes.Where(p =>
                (p.Apellido?.Contains(busq, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Nombre?.Contains(busq, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Email?.Contains(busq, StringComparison.OrdinalIgnoreCase) ?? false) ||
                p.NroDni.ToString().Contains(busq) ||
                p.NroPaciente.ToString().Contains(busq)
            ).ToList();
        }
    }

    private IEnumerable<PacienteDTO> PaginaActualPacientes =>
        PacientesFiltrados.Skip((paginaActual - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var rol = await AuthService.GetRolAsync();
        esAdmin = rol == "Administrador";
        autorizado = esAdmin || rol == "Odontologo";

        if (autorizado)
            await CargarPacientesAsync();

        loading = false;
    }

    private async Task CargarPacientesAsync()
    {
        errorMessage = string.Empty;

        PacienteApiClient.SetToken(await AuthService.GetTokenAsync());
        var resultado = await PacienteApiClient.GetAllAsync();

        if (resultado is null)
        {
            errorMessage = "No se pudieron cargar los pacientes. Verificá que el WebAPI esté corriendo y que tu sesión siga activa.";
            return;
        }

        pacientes = resultado.OrderBy(p => p.Apellido).ThenBy(p => p.Nombre).ToList();
    }

    private async Task EliminarAsync(PacienteDTO paciente)
    {
        if (!esAdmin)
            return;

        bool confirmar = await JSRuntime.InvokeAsync<bool>(
            "confirm", $"¿Eliminar a {paciente.Apellido}, {paciente.Nombre}? Esta acción no se puede deshacer.");

        if (!confirmar)
            return;

        PacienteApiClient.SetToken(await AuthService.GetTokenAsync());

        if (await PacienteApiClient.EliminarAsync(paciente.NroPaciente))
            await CargarPacientesAsync();
        else
            errorMessage = "No se pudo eliminar el paciente. Puede tener reservas asociadas.";
    }
}