@using Domain.Model
@using System.Text.RegularExpressions
@inject OdontologoApiClient OdontologoApiClient
@inject IBlazorAuthService AuthService

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(mode == FormMode.Add ? "Agregar odontólogo" : "Editar odontólogo")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentOdontologo" OnValidSubmit="HandleValidSubmit">

                        <div class="mb-3">
                            <label class="form-label">Matrícula *</label>
                            @if (mode == FormMode.Update)
                            {
                                <input type="text" class="form-control" value="@currentOdontologo.Matricula" readonly />
                            }
                            else
                            {
                                <InputText @bind-Value="currentOdontologo.Matricula" class="form-control" />
                            }
                            @if (validationErrors.ContainsKey("Matricula"))
                            {
                                <div class="text-danger small">@validationErrors["Matricula"]</div>
                            }
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre *</label>
                                <InputText @bind-Value="currentOdontologo.Nombre" class="form-control" />
                                @if (validationErrors.ContainsKey("Nombre"))
                                {
                                    <div class="text-danger small">@validationErrors["Nombre"]</div>
                                }
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellido *</label>
                                <InputText @bind-Value="currentOdontologo.Apellido" class="form-control" />
                                @if (validationErrors.ContainsKey("Apellido"))
                                {
                                    <div class="text-danger small">@validationErrors["Apellido"]</div>
                                }
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label class="form-label">Tipo de documento *</label>
                                <InputSelect @bind-Value="currentOdontologo.TipoDocumento" class="form-select">
                                    @foreach (var tipo in Enum.GetValues<tiposEnumerados>())
                                    {
                                        <option value="@tipo">@tipo</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-7 mb-3">
                                <label class="form-label">Nº de documento *</label>
                                <InputNumber @bind-Value="currentOdontologo.NroDocumento" class="form-control" />
                                @if (validationErrors.ContainsKey("NroDocumento"))
                                {
                                    <div class="text-danger small">@validationErrors["NroDocumento"]</div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Especialidad *</label>
                            <InputText @bind-Value="currentOdontologo.Especialidad" class="form-control" />
                            @if (validationErrors.ContainsKey("Especialidad"))
                            {
                                <div class="text-danger small">@validationErrors["Especialidad"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email *</label>
                            <InputText @bind-Value="currentOdontologo.Email" class="form-control" />
                            @if (validationErrors.ContainsKey("Email"))
                            {
                                <div class="text-danger small">@validationErrors["Email"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                @(mode == FormMode.Add ? "Contraseña *" : "Nueva contraseña")
                            </label>
                            <InputText type="password" @bind-Value="currentOdontologo.Password" class="form-control" autocomplete="new-password" />
                            @if (mode == FormMode.Update)
                            {
                                <div class="form-text">Dejala vacía para mantener la actual.</div>
                            }
                            @if (validationErrors.ContainsKey("Password"))
                            {
                                <div class="text-danger small">@validationErrors["Password"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(mode == FormMode.Add ? "Agregar" : "Guardar cambios")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnOdontologoChanged { get; set; }

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private OdontologoDTO currentOdontologo = new OdontologoDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();

    public enum FormMode
    {
        Add,
        Update
    }

    public Task ShowAddModal()
    {
        mode = FormMode.Add;
        currentOdontologo = new OdontologoDTO();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public Task ShowEditModal(OdontologoDTO odontologo)
    {
        mode = FormMode.Update;
        currentOdontologo = new OdontologoDTO
        {
            Matricula = odontologo.Matricula,
            NroDocumento = odontologo.NroDocumento,
            TipoDocumento = odontologo.TipoDocumento,
            Especialidad = odontologo.Especialidad,
            Nombre = odontologo.Nombre,
            Apellido = odontologo.Apellido,
            Email = odontologo.Email,
            Password = string.Empty
        };
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleValidSubmit()
    {
        if (!ValidateOdontologo())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            OdontologoApiClient.SetToken(await AuthService.GetTokenAsync());

            bool ok = mode == FormMode.Add
                ? await OdontologoApiClient.CrearAsync(currentOdontologo)
                : await OdontologoApiClient.ActualizarAsync(currentOdontologo);

            if (!ok)
            {
                errorMessage = "No se pudo guardar el odontólogo. Revisá los datos (la matrícula no puede repetirse) o volvé a iniciar sesión.";
                return;
            }

            await OnOdontologoChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool ValidateOdontologo()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(currentOdontologo.Matricula))
        {
            validationErrors["Matricula"] = "La matrícula es obligatoria";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentOdontologo.Nombre))
        {
            validationErrors["Nombre"] = "El nombre es obligatorio";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentOdontologo.Apellido))
        {
            validationErrors["Apellido"] = "El apellido es obligatorio";
            isValid = false;
        }

        if (currentOdontologo.NroDocumento <= 0)
        {
            validationErrors["NroDocumento"] = "Ingresá un número de documento válido";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentOdontologo.Especialidad))
        {
            validationErrors["Especialidad"] = "La especialidad es obligatoria";
            isValid = false;
        }

        if (string.IsNullOrWhiteSpace(currentOdontologo.Email))
        {
            validationErrors["Email"] = "El email es obligatorio";
            isValid = false;
        }
        else if (!Regex.IsMatch(currentOdontologo.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            validationErrors["Email"] = "El formato del email no es válido";
            isValid = false;
        }

        if (mode == FormMode.Add && string.IsNullOrWhiteSpace(currentOdontologo.Password))
        {
            validationErrors["Password"] = "La contraseña es obligatoria";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}